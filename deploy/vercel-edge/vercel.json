{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/onboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://mirror-v-origin.tianyi.live/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "https://mirror-v-origin.tianyi.live/admin/index.html"
    },
    {
      "source": "/:path*",
      "destination": "https://mirror-v-origin.tianyi.live/:path*"
    }
  ]
}
