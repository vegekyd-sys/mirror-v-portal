{
  "ai_name": "小元",
  "user_name": "田耕郡",
  "timezone": "Asia/Shanghai",
  "storage": {
    "backend": "local",
    "local": {
      "reflections_dir": "memory/reflections",
      "logs_dir": "memory/logs",
      "memory_file": "MEMORY.md"
    }
  },
  "notifications": {
    "backend": "none"
  },
  "heartbeat": {
    "interval_hours": 6,
    "enabled": true,
    "tasks": [
      "reflection_analysis",
      "memory_scan",
      "log_compress"
    ]
  },
  "reflection": {
    "min_pattern_count": 2,
    "auto_write": true,
    "auto_capture_stale_hours": 24
  }
}