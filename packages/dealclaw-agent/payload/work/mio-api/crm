def envelope(data, meta=None):
    emit(data, meta={"version": VERSION, **(meta or {})})


def fields_arg(value: str | None, defaults: list[str]) -> list[str]:
    return list(dict.fromkeys(defaults + split_csv(value)))


def with_aliases(records: list[dict]) -> list[dict]:
    return [normalize_record(r, ALIASES) for r in records]


