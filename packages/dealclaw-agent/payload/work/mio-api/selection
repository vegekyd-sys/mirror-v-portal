#!/usr/bin/env python3
"""Agent-callable data-selection/CDP CLI."""
from __future__ import annotations

import argparse
import os
from agent_cli_common import emit, fail, safe_call
from mio_cdp_client import MioCdpClient


# ── 自动加载 .env（含 entrypoint 建立的 work/mio-api/.env 符号链接）──────────
def _load_env_file() -> None:
    d = os.path.dirname(os.path.abspath(__file__))
    while d and d != os.path.dirname(d):
        for env_file in (os.path.join(d, "work", "mio-api", ".env"), os.path.join(d, ".env")):
            if os.path.isfile(env_file):
                with open(env_file, encoding="utf-8") as fh:
                    for line in fh:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            if k not in os.environ:
                                os.environ[k] = v.strip()
        d = os.path.dirname(d)


_load_env_file()

VERSION="agent-friendly-selection-cli/3.0.0"
INDUSTRY_DICT={"宠物":{"dictCode":"PET","keywords":["宠物","pet"]},"工业":{"dictCode":"INDUSTRIAL","keywords":["工业"]},"家纺":{"dictCode":"TEXTILE","keywords":["家纺","textile"]}}
COUNTRY_ALIASES={"印尼":"Indonesia","印度":"India","越南":"Vietnam","巴西":"Brazil","沙特":"Saudi Arabia"}
COMMANDS={
 "search":{"args":{"--industry":"string","--country":"string","--max-results":"int","--supplier-id":"string","--pps-id":"string"},"example":"selection search --industry 宠物 --country 印尼","live":True},
 "cdp":{"args":{"--industry":"string","--max-results":"int"},"example":"selection cdp --industry 宠物 --max-results 10000","live":True},
 "buyers":{"args":{"--industry":"string","--country":"string"},"example":"selection buyers --industry 宠物","live":True},
 "company":{"args":{"--id":"string required"},"example":"selection company --id xxx","live":True},
 "trade":{"args":{"--company-id":"string required"},"example":"selection trade --company-id xxx","live":True},
 "exhibitions":{"args":{"--company-id":"string","--page":"int","--size":"int"},"example":"selection exhibitions --company-id xxx","live":True},
 "products":{"args":{"--company-id":"string required"},"example":"selection products --company-id xxx","live":True},
 "industries":{"args":{},"example":"selection industries","live":False},
}

def envelope(data, meta=None): emit(data, meta={"version":VERSION, **(meta or {})})

def client():
    app_key=os.environ.get("MIO_CDP_APP_KEY","tradechina")
    app_secret=os.environ.get("MIO_CDP_APP_SECRET") or os.environ.get("SELECTION_API_TOKEN")
    if not app_secret: fail("MISSING_ENV","请设置 MIO_CDP_APP_SECRET 或 SELECTION_API_TOKEN")
    return MioCdpClient(app_key=app_key, app_secret=app_secret, env=os.environ.get("MIO_CDP_ENV","prod"))

def keyword(industry):
    if not industry: return ""
    return INDUSTRY_DICT.get(industry,{}).get("keywords",[industry])[0]

def mock(cmd):
    return {
      "search":[{"companyName":"印尼宠物展商Mock","industry":"宠物","country":"Indonesia"}],
      "cdp":[{"companyName":"宠物行业企业Mock","dictCode":"PET"}],
      "buyers":[{"buyerName":"Pet Buyer Mock"}],
      "company":[{"companyCdpId":"mock-company","registeredCapital":"100万"}],
      "trade":[{"companyCdpId":"mock-company","tradeOverView":{"shipments":1}}],
      "exhibitions":[{"exhibitionName":"2026JPE雅加达国际宠物展"}],
      "products":[{"product":"宠物食品"}],
      "industries":INDUSTRY_DICT,
    }.get(cmd,[{"ok":True}])

def plan(args):
    return {"command":args.cmd,"filters":{k:v for k,v in vars(args).items() if k not in ("dry_run","mock") and v not in (None,False)},"notes":["live search requires CDP supplier_id and pps_id"]}

def maybe(args):
    if args.dry_run: envelope(plan(args), meta={"mode":"dry-run"}); return True
    if args.mock: envelope(mock(args.cmd), meta={"mode":"mock","plan":plan(args)}); return True
    return False

def list_all_ai(c,args):
    supplier_id=args.supplier_id or os.environ.get("MIO_CDP_SUPPLIER_ID","")
    pps_id=args.pps_id or os.environ.get("MIO_CDP_PPS_ID","")
    if not supplier_id or not pps_id: fail("MISSING_ARG","AI/CDP 搜索需要 --supplier-id/--pps-id 或 MIO_CDP_SUPPLIER_ID/MIO_CDP_PPS_ID")
    rows=[]; page=1; page_size=min(100,max(1,args.max_results)); countries=[COUNTRY_ALIASES.get(args.country,args.country)] if args.country else None
    while len(rows)<args.max_results:
        result=c.search_ai_v2(supplier_id=supplier_id,pps_id=pps_id,keyword=keyword(args.industry),country=countries,page_num=page,page_size=page_size)
        page_obj=result.get("page") if isinstance(result,dict) else None
        records=(page_obj or result).get("records") if isinstance((page_obj or result),dict) else []
        records=records or (result.get("data") if isinstance(result,dict) else [])
        if not records: break
        rows.extend(records); total=(page_obj or {}).get("total") or result.get("total") or 0
        if len(rows)>=total or len(records)<page_size: break
        page+=1
    return rows[:args.max_results]

def build_parser():
    p=argparse.ArgumentParser(prog="selection", description="Agent-callable CDP/data-selection CLI")
    p.add_argument("--version", action="store_true")
    sub=p.add_subparsers(dest="cmd")
    sub.add_parser("commands"); sub.add_parser("schema")
    def add_global(sp): sp.add_argument("--dry-run",action="store_true"); sp.add_argument("--mock",action="store_true")
    for name in ["search","cdp","buyers"]:
        sp=sub.add_parser(name); sp.add_argument("--industry"); sp.add_argument("--country"); sp.add_argument("--max-results",type=int,default=100); sp.add_argument("--supplier-id"); sp.add_argument("--pps-id"); add_global(sp)
    sp=sub.add_parser("industries"); add_global(sp)
    sp=sub.add_parser("company"); sp.add_argument("--id",required=True); add_global(sp)
    sp=sub.add_parser("trade"); sp.add_argument("--company-id",required=True); add_global(sp)
    sp=sub.add_parser("exhibitions"); sp.add_argument("--company-id"); sp.add_argument("--page",type=int,default=1); sp.add_argument("--size",type=int,default=10); add_global(sp)
    sp=sub.add_parser("products"); sp.add_argument("--company-id",required=True); add_global(sp)
    return p

def main():
    args=build_parser().parse_args()
    if args.version: return envelope({"version":VERSION})
    if not args.cmd: return fail("MISSING_COMMAND","run `selection commands` or `selection schema`")
    if args.cmd=="commands": return envelope(COMMANDS)
    if args.cmd=="schema": return envelope({"version":VERSION,"commands":COMMANDS,"industries":INDUSTRY_DICT,"countries":COUNTRY_ALIASES})
    if maybe(args): return
    if args.cmd=="industries": return envelope(INDUSTRY_DICT)
    c=client()
    if args.cmd in ("search","cdp","buyers"): return envelope(list_all_ai(c,args))
    if args.cmd=="company": return envelope(c.get_details(args.id))
    if args.cmd=="trade": return envelope(c.get_details(args.company_id), meta={"source":"get_details.tradeOverView"})
    if args.cmd=="exhibitions":
        if args.company_id: return envelope([], meta={"notice":"当前 CDP 客户端未提供按 company-id 查询参展历史独立接口"})
        return envelope(c.list_exhibitions(page=args.page,size=args.size))
    if args.cmd=="products": return envelope([], meta={"notice":"当前 CDP 客户端未提供 products 独立接口；待上游补充"})
    fail("UNKNOWN_CMD",args.cmd)

if __name__=="__main__": safe_call(main)
