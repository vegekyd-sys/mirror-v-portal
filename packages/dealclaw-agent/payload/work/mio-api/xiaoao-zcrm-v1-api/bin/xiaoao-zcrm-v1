#!/usr/bin/env python3
"""CLI wrapper for Meorient CRM Agent V1.04 HTTP API.

Auth:
  CRM_API_KEY env stores either "Bearer xxx" or pure token.
  HTTP requests always send Authorization: Bearer <token>.
  Never send CRM_API_KEY as an HTTP header.
"""
from __future__ import annotations

import argparse
import csv
import json
import os
import sys
import textwrap
import urllib.error
import urllib.request
from typing import Any, Dict, Iterable, List, Optional, Tuple

BASE_URL = os.getenv("ZCRM_V1_BASE_URL", "https://zohodata.meorient.com/agent").rstrip("/")
if BASE_URL.endswith("/v1"):
    API_BASE = BASE_URL
else:
    API_BASE = BASE_URL + "/v1"

LIST_ENDPOINTS = {
    "/accounts/search",
    "/deals/search",
    "/deals/byAccount",
    "/orders/search",
    "/orders/receipts",
    "/events/search",
    "/users/all",
    "/settlements/search",
}

DISABLED_ENDPOINTS = {
    "/orders/fields": "V1.04 文档标记已停用：/agent/v1/orders/fields 不再提供。",
    "/orders/dictionary": "V1.04 文档标记已停用：/agent/v1/orders/dictionary 不再提供。",
}


class FriendlyFormatter(argparse.RawDescriptionHelpFormatter):
    """Keep business examples readable while still showing defaults."""

    pass


TOP_HELP = """小奥 CRM 查询 CLI / Agent V1.04

用于一条命令查询 CRM 客户、商机、合同、会议拜访、用户信息。
服务器根地址默认 https://zohodata.meorient.com/agent；业务接口自动拼接 /v1。
默认输出简表；加 --json 输出完整 JSON，方便 Agent 二次统计。

常用问题示例：
  查宠物客户总量：
    xiaoao-zcrm-v1 accounts search --industry-tags "宠物" --json

  查张丽娜负责的客户：
    xiaoao-zcrm-v1 accounts search --owner-name "张丽娜" --json

  查 7 月赢单业绩（业绩提交日期 Up_Orders_Day）：
    xiaoao-zcrm-v1 orders search --stage "赢单" \\
      --performance-from 2026-07-01 --performance-to 2026-07-31 --json

  查 2026 印尼展赢单合同：
    xiaoao-zcrm-v1 orders search --project "2026" --stage "赢单" --json
    # Agent 再按展会简称表/项目名筛“印尼”并汇总。

  查公司 360 概览：
    xiaoao-zcrm-v1 accounts overview --name "广州辉洋进出口有限公司" --json

  查合同实收/确收：
    xiaoao-zcrm-v1 orders receipts --contract-id 185165004027994962 --json

  查结算单：
    xiaoao-zcrm-v1 settlements search --from 2026-07-01 --to 2026-07-31 --json

关键口径：
  - “参加过 / 复购”默认只统计合同阶段=赢单。
  - “X月业绩 / X月赢单合同”默认按业绩提交日期 Up_Orders_Day。
  - “X月印尼 / X月某展”默认先查展会简称表，再按 Start_Date/项目取数。
  - 客户负责人查询用 --owner-name，不推荐 --owner-id。
  - 合同搜索默认服务端按 exhibition_type=自办展；需要代理展等类型请显式传 --exhibition-type。
  - 实收/确收来自审批通过的结算单：orders search 返回合同当前页汇总，orders receipts/settlements search 可单独查询。

更多帮助：
  xiaoao-zcrm-v1 accounts search --help
  xiaoao-zcrm-v1 orders search --help
  xiaoao-zcrm-v1 events search --help
  xiaoao-zcrm-v1 users search --help
  xiaoao-zcrm-v1 orders receipts --help
  xiaoao-zcrm-v1 settlements search --help
"""


