def load_token() -> str:
    raw = os.getenv("CRM_API_KEY", "").strip()
    if not raw:
        return ""
    prefix = "Bearer "
    return raw[len(prefix):].strip() if raw.startswith(prefix) else raw


def post(path: str, payload: Dict[str, Any], timeout: int = 180) -> Dict[str, Any]:
    token = load_token()
    if not token:
        return {"count": 0, "data": [], "msg": "MISSING_ENV: CRM_API_KEY", "code": 10001}
    url = API_BASE + path
    req = urllib.request.Request(
        url,
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", "replace")
            body = json.loads(raw) if raw else {}
            if isinstance(body, dict):
                body.setdefault("_http", resp.status)
            return body
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            body = json.loads(raw) if raw else {}
            if isinstance(body, dict):
                body.setdefault("_http", e.code)
                return body
        except Exception:
            pass
        return {"count": 0, "data": [], "error": f"HTTP {e.code}: {raw[:240]}", "_http": e.code}
    except Exception as e:
        return {"count": 0, "data": [], "error": f"{type(e).__name__}: {str(e)[:240]}"}


def clean_payload(d: Dict[str, Any]) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for k, v in d.items():
        if v is None:
            continue
        if isinstance(v, str) and v == "":
            continue
        if isinstance(v, list):
            vv = [x for x in v if x not in (None, "")]
            if vv:
                out[k] = vv
            continue
        out[k] = v
    return out


def csv_or_repeat(values: Optional[List[str]]) -> List[str]:
    if not values:
        return []
    out: List[str] = []
    for value in values:
        if value is None:
            continue
        for part in str(value).split(","):
            part = part.strip()
            if part:
                out.append(part)
    # de-duplicate preserving order
    seen = set()
    deduped = []
    for x in out:
        if x not in seen:
            seen.add(x)
            deduped.append(x)
    return deduped


def extract_value(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, dict):
        for key in ("name", "full_name", "id", "email"):
            if value.get(key):
                return str(value.get(key))
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return ", ".join(extract_value(v) for v in value)
    return str(value)


def print_table(rows: List[Dict[str, Any]], columns: List[Tuple[str, str]], limit: int) -> None:
    rows = rows[:limit]
    if not rows:
        print("未查到记录")
        return
    matrix: List[List[str]] = []
    headers = [title for _, title in columns]
    for row in rows:
        matrix.append([extract_value(row.get(key, "")) for key, _ in columns])
    widths = [len(h) for h in headers]
    for row in matrix:
        for i, cell in enumerate(row):
            widths[i] = min(max(widths[i], len(cell)), 40)
    def clip(s: str, w: int) -> str:
        return s if len(s) <= w else s[: w - 1] + "…"
    print(" | ".join(clip(h, widths[i]).ljust(widths[i]) for i, h in enumerate(headers)))
    print("-+-".join("-" * w for w in widths))
    for row in matrix:
        print(" | ".join(clip(cell, widths[i]).ljust(widths[i]) for i, cell in enumerate(row)))


def default_columns(path: str, data: Any) -> List[Tuple[str, str]]:
    if path.startswith("/accounts"):
        return [("id", "ID"), ("name", "客户名称"), ("industry_custom", "行业"), ("customer_level", "客户级别"), ("owner_name", "负责人")]
    if path.startswith("/deals"):
        return [("id", "ID"), ("account_name", "客户"), ("project_name", "项目"), ("stage", "阶段"), ("zone_name", "展区"), ("sales", "销售")]
    if path == "/orders/receipts":
        return [("contract_id", "合同ID"), ("contract_no", "合同编码"), ("account_name", "客户"), ("sales", "销售"), ("contract_stage", "合同阶段"), ("total_received", "总实收"), ("total_confirmed", "总确收")]
    if path.startswith("/orders"):
        return [("id", "ID"), ("contract_code", "合同编码"), ("account_name", "客户"), ("contract_stage", "合同阶段"), ("project_name", "项目"), ("first_exhibition", "一级展会"), ("exhibition_type", "展会类型"), ("is_rollover", "转展"), ("sales", "销售"), ("amount", "金额"), ("total_received", "总实收"), ("total_confirmed", "总确收"), ("up_orders_day", "业绩提交日")]
    if path.startswith("/events"):
        return [("id", "ID"), ("account_name", "客户"), ("start_time", "开始"), ("end_time", "结束"), ("sales", "销售"), ("meeting_url", "妙记")]
    if path.startswith("/users"):
        return [("id", "Zoho ID"), ("name", "姓名"), ("email", "邮箱"), ("first_department", "一级部门"), ("second_department", "二级部门")]
    if path.startswith("/settlements"):
        return [("id", "结算单ID"), ("payment_amount", "水单金额"), ("write_amount", "核销金额"), ("first_department", "一级部门"), ("up_orders_day", "业绩提交日"), ("sales", "销售"), ("approval_status", "审批状态")]
    return []


def is_success(res: Dict[str, Any]) -> bool:
    code = res.get("code", 0 if "code" not in res else res.get("code"))
    # V1.04 统一 code=0；orders/receipts 文档示例兼容 code="OK"。
    if code not in (0, "0", "OK", None):
        return False
    if res.get("error"):
        return False
    return True


def response_message(res: Dict[str, Any]) -> str:
    return str(res.get("msg") or res.get("error") or "")


def render(res: Dict[str, Any], path: str, json_mode: bool, limit: int) -> int:
    http = res.get("_http")
    if "_http" in res:
        res = dict(res)
        res.pop("_http", None)
    ok = is_success(res)
    if json_mode:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if ok else 2
    if not ok:
        print(f"错误: {response_message(res)}")
        if res.get("code") is not None:
            print(f"code: {res.get('code')}")
        if http:
            print(f"HTTP: {http}")
        return 2
    count = res.get("count")
    more = res.get("more_records")
    page = res.get("page")
    if path == "/events/count":
        data = res.get("data") or {}
        total = data.get("total") if isinstance(data, dict) else None
        print(f"会议/拜访记录数量: {total if total is not None else ''}")
        print(f"count={count}, code={res.get('code', 0)}, msg=\"{response_message(res)}\"")
        return 0
    data = res.get("data")
    if path == "/accounts/overview":
        print(f"count={count}, code={res.get('code', 0)}, msg=\"{response_message(res)}\"")
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    print(f"count={count}, page={page if page is not None else ''}, more_records={more if more is not None else ''}, code={res.get('code', 0)}, msg=\"{response_message(res)}\"")
    if isinstance(data, list):
        print_table(data, default_columns(path, data), limit)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    return 0


def add_common_search(p: argparse.ArgumentParser, fields: Iterable[str]) -> None:
    for f in fields:
        p.add_argument(f"--{f.replace('_', '-')}", dest=f)
    p.add_argument("--page", type=int)


def add_output_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--json", action="store_true", help="输出完整 JSON")
    p.add_argument("--limit", type=int, default=20, help="表格最多展示行数，默认20")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="xiaoao-zcrm-v1",
        description="小奥 CRM Agent V1.04 CLI：包装 https://zohodata.meorient.com/agent 下所有明确业务接口，一条命令出结果。",
        epilog=TOP_HELP,
        formatter_class=FriendlyFormatter,
    )
    sub = parser.add_subparsers(dest="module", required=True)

    acc = sub.add_parser(
        "accounts",
        help="查客户：公司、行业、负责人、客户级别",
        description="客户查询：公司、行业、负责人、客户级别。常用：accounts search --name/--owner-name/--industry-tags。",
        formatter_class=FriendlyFormatter,
    )
    acc_sub = acc.add_subparsers(dest="action", required=True)
    p = acc_sub.add_parser(
        "search",
        help="搜索客户 / 客户总量 / 负责人客户 / 行业客户",
        description="搜索客户：支持公司名、负责人、行业标签等条件。",
        epilog=ACCOUNTS_SEARCH_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["name", "customer_level", "data_type", "industry_tags", "product_tags", "registered_area", "registered_district", "province", "city", "source", "owner_name", "recent_touch_time", "recent_contact_time"])
    p.add_argument("--owner-id", dest="owner_id", help="历史兼容参数；V1.04 推荐使用 --owner-name。若传入则仍按 owner_id 字段发送，服务端可能不再支持。")
    add_output_args(p)
    p = acc_sub.add_parser("by-names", help="按完整公司名称批量查询客户", formatter_class=FriendlyFormatter)
    p.add_argument("--name", action="append", dest="names", help="可重复；也可逗号分隔")
    p.add_argument("--names", action="append", dest="names_csv", help="逗号分隔公司名")
    add_output_args(p)
    p = acc_sub.add_parser("by-ids", help="按客户ID批量查询客户", formatter_class=FriendlyFormatter)
    p.add_argument("--id", action="append", dest="ids", help="可重复；也可逗号分隔")
    p.add_argument("--ids", action="append", dest="ids_csv", help="逗号分隔客户ID")
    add_output_args(p)
    p = acc_sub.add_parser("overview", help="公司360概览：客户+商机+合同+会议", formatter_class=FriendlyFormatter)
    p.add_argument("--name", required=True)
    add_output_args(p)

    deals = sub.add_parser(
        "deals",
        help="查商机：阶段、项目、销售、客户",
        description="商机查询：用于商机阶段/项目/销售分析；合同统计优先用 orders。",
        formatter_class=FriendlyFormatter,
    )
    deals_sub = deals.add_subparsers(dest="action", required=True)
    p = deals_sub.add_parser(
        "search",
        help="搜索商机 / 阶段 / 销售 / 项目",
        description="搜索商机：支持阶段、销售、客户、项目等条件。",
        epilog=DEALS_SEARCH_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["stage", "sales", "account_name", "project", "first_department", "first_exhibition", "zone", "second_exhibition"])
    add_output_args(p)
    p = deals_sub.add_parser("by-account", help="按客户ID查询关联商机", formatter_class=FriendlyFormatter)
    p.add_argument("--account-id", required=True, dest="account_id")
    p.add_argument("--page", type=int)
    add_output_args(p)

    orders = sub.add_parser(
        "orders",
        help="查合同/赢单/业绩/展位数",
        description="合同查询：用于赢单、业绩、展会合同、金额、展位数/面积统计。",
        formatter_class=FriendlyFormatter,
    )
    orders_sub = orders.add_subparsers(dest="action", required=True)
    p = orders_sub.add_parser(
        "search",
        help="搜索合同 / 赢单 / 业绩 / 展会合同 / 展位数",
        description="搜索合同：支持合同阶段、项目、销售、客户、展会日期、业绩提交日期等。",
        epilog=ORDERS_SEARCH_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["zone", "project", "stage", "exhibition_type", "is_rollover", "sales", "account_name", "special_zone", "first_department", "contract_code", "first_exhibition", "customer_product", "second_exhibition", "from", "to", "performance_from", "performance_to"])
    add_output_args(p)
    p = orders_sub.add_parser(
        "receipts",
        help="查询合同实收确收 / BI 合同收款汇总",
        description="查询合同实收确收：按合同/日期/销售/部门/展会从 BI 汇总总实收、总确收。",
        epilog=RECEIPTS_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["contract_id", "from", "to", "sales", "first_department", "account_name", "first_exhibition", "second_exhibition", "contract_stage"])
    add_output_args(p)
    orders_sub.add_parser("fields", help="已停用：/agent/v1/orders/fields", formatter_class=FriendlyFormatter)
    orders_sub.add_parser("dictionary", help="已停用：/agent/v1/orders/dictionary", formatter_class=FriendlyFormatter)

    events = sub.add_parser(
        "events",
        help="查会议/拜访记录/妙记",
        description="会议/拜访记录查询：用于客户拜访、销售活动、妙记链接。",
        formatter_class=FriendlyFormatter,
    )
    events_sub = events.add_subparsers(dest="action", required=True)
    p = events_sub.add_parser(
        "search",
        help="搜索会议/拜访记录 / 妙记",
        description="搜索会议/拜访记录：支持客户、销售、部门、日期范围。",
        epilog=EVENTS_SEARCH_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["account_id", "from", "to", "sales", "first_department", "company_name"])
    add_output_args(p)
    p = events_sub.add_parser("count", help="统计会议/拜访记录数量", formatter_class=FriendlyFormatter)
    p.add_argument("--account-id", dest="account_id")
    p.add_argument("--from", dest="from")
    p.add_argument("--to", dest="to")
    add_output_args(p)

    users = sub.add_parser(
        "users",
        help="查Zoho用户：姓名、ID、部门、邮箱",
        description="用户查询：按姓名查 Zoho 用户 ID、部门、邮箱；负责人客户查询优先 accounts search --owner-name。",
        formatter_class=FriendlyFormatter,
    )
    users_sub = users.add_subparsers(dest="action", required=True)
    p = users_sub.add_parser("all", help="分页列出Zoho用户", formatter_class=FriendlyFormatter)
    p.add_argument("--page", type=int)
    add_output_args(p)
    p = users_sub.add_parser("search", help="按 first_name 查Zoho用户", formatter_class=FriendlyFormatter)
    p.add_argument("--name", required=True)
    add_output_args(p)

    settlements = sub.add_parser(
        "settlements",
        help="查结算单：水单金额、核销金额、业绩提交日",
        description="结算单查询：从 BI 结算单表按合同、日期、销售、部门、展会等条件查询。",
        formatter_class=FriendlyFormatter,
    )
    settlements_sub = settlements.add_subparsers(dest="action", required=True)
    p = settlements_sub.add_parser(
        "search",
        help="搜索结算单 / 水单 / 核销",
        description="搜索结算单：支持合同ID、业绩提交日期、销售、部门、展会等条件。",
        epilog=SETTLEMENTS_SEARCH_HELP,
        formatter_class=FriendlyFormatter,
    )
    add_common_search(p, ["order_id", "from", "to", "sales", "first_department", "account_name", "first_exhibition", "second_exhibition"])
    add_output_args(p)

    raw = sub.add_parser(
        "raw",
        help="高级调试：直接按 path/payload 调用，不建议日常使用",
        description="高级调试入口：直接请求 /agent/v1 路径。日常 CRM 查询优先使用 accounts/deals/orders/events/users。",
        formatter_class=FriendlyFormatter,
    )
    raw.add_argument("--path", required=True, help="例如 /accounts/search 或 /agent/v1/accounts/search")
    raw.add_argument("--payload", default="{}", help="JSON 字符串")
    add_output_args(raw)
    return parser


def dispatch(args: argparse.Namespace) -> Tuple[str, Dict[str, Any]]:
    m, a = args.module, getattr(args, "action", None)
    if m == "accounts" and a == "search":
        payload = clean_payload({k: getattr(args, k, None) for k in ["name", "customer_level", "data_type", "industry_tags", "product_tags", "registered_area", "registered_district", "province", "city", "source", "owner_name", "recent_touch_time", "recent_contact_time", "page"]})
        # 历史兼容：旧脚本可能仍传 --owner-id；V1.04 文档推荐 owner_name
        if getattr(args, "owner_id", None):
            payload["owner_id"] = args.owner_id
        return "/accounts/search", payload
    if m == "accounts" and a == "by-names":
        names = csv_or_repeat((args.names or []) + (args.names_csv or []))
        return "/accounts/byNames", {"names": names}
    if m == "accounts" and a == "by-ids":
        ids = csv_or_repeat((args.ids or []) + (args.ids_csv or []))
        return "/accounts/byIds", {"ids": ids}
    if m == "accounts" and a == "overview":
        return "/accounts/overview", {"name": args.name}
    if m == "deals" and a == "search":
        return "/deals/search", clean_payload({k: getattr(args, k) for k in ["stage", "sales", "account_name", "project", "first_department", "first_exhibition", "zone", "second_exhibition", "page"]})
    if m == "deals" and a == "by-account":
        return "/deals/byAccount", clean_payload({"account_id": args.account_id, "page": args.page})
    if m == "orders" and a == "search":
        return "/orders/search", clean_payload({k: getattr(args, k) for k in ["zone", "project", "stage", "exhibition_type", "is_rollover", "sales", "account_name", "special_zone", "first_department", "contract_code", "first_exhibition", "customer_product", "second_exhibition", "from", "to", "performance_from", "performance_to", "page"]})
    if m == "orders" and a == "receipts":
        return "/orders/receipts", clean_payload({k: getattr(args, k) for k in ["contract_id", "from", "to", "sales", "first_department", "account_name", "first_exhibition", "second_exhibition", "contract_stage", "page"]})
    if m == "orders" and a in ("fields", "dictionary"):
        path = "/orders/fields" if a == "fields" else "/orders/dictionary"
        print(DISABLED_ENDPOINTS[path], file=sys.stderr)
        raise SystemExit(2)
    if m == "events" and a == "search":
        return "/events/search", clean_payload({k: getattr(args, k) for k in ["account_id", "from", "to", "sales", "first_department", "company_name", "page"]})
    if m == "events" and a == "count":
        return "/events/count", clean_payload({"account_id": args.account_id, "from": getattr(args, "from"), "to": args.to})
    if m == "users" and a == "all":
        return "/users/all", clean_payload({"page": args.page})
    if m == "users" and a == "search":
        return "/users/search", {"name": args.name}
    if m == "settlements" and a == "search":
        return "/settlements/search", clean_payload({k: getattr(args, k) for k in ["order_id", "from", "to", "sales", "first_department", "account_name", "first_exhibition", "second_exhibition", "page"]})
    if m == "raw":
        path = args.path
        if path.startswith("/agent/v1"):
            path = path[len("/agent/v1"):]
        try:
            payload = json.loads(args.payload)
        except Exception as e:
            print(f"payload JSON 解析失败: {e}", file=sys.stderr)
            raise SystemExit(2)
        if not isinstance(payload, dict):
            print("payload 必须是 JSON object", file=sys.stderr)
            raise SystemExit(2)
        return path, payload
    raise SystemExit("unknown command")


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    path, payload = dispatch(args)
    res = post(path, payload)
    return render(res, path, getattr(args, "json", False), getattr(args, "limit", 20))


if __name__ == "__main__":
    raise SystemExit(main())
