# =============================================================================
# WhatsApp 桥接服务环境变量模板
# 复制为 .env.shared / .env.development / .env.production 后填真实值。
# 不要把填好密钥的文件提交进 git。
# 加载顺序（后者覆盖前者）：
#   .env.shared → .env.$APP_ENV → .env.$APP_ENV.local → .env.local → .env
# APP_ENV：development | test | production
#   npm run dev        → development
#   npm run start:test → test
#   npm run start / start:prod → production
# 调试加载列表：DEBUG_ENV=1
# =============================================================================

APP_ENV=development
PORT=3000

# 智能体调用桥接时用的公网/内网基址（服务本身监听不依赖它）
WHATSAPP_BRIDGE_BASE_URL=https://your-bridge.example.com

# CDP 供应商 ID，嵌入式注册的 partnerCustomerId。未配置时创建 Onboarding Link 会 400
MIO_CDP_SUPPLIER_ID=

# ---------- PostgreSQL ----------
# 可把账号密码写进 URL，也可拆到 USER/PASSWORD（无 username 时才会拼进去）
DATABASE_URL=postgresql://127.0.0.1:5432/postgres
DATABASE_USER=
DATABASE_PASSWORD=
# 必须与表所在 schema 一致；现有 migration / 建表 SQL 使用下面这个名字
DATABASE_SCHEMA=whatsapp_platform_bridge

# ---------- YCloud WhatsApp ----------
YCLOUD_API_KEY=
# Webhook 验签密钥（生产必填；跳过验签仅限本地）
YCLOUD_WEBHOOK_SECRET=
# 绑定成功后可由 Webhook 写入当前进程和 env 文件；未填则视为未绑定（不会用库里旧 WABA）
YCLOUD_WABA_ID=
# 当前 WABA 默认企业号，E.164，例如 +85251111111
YCLOUD_FROM=

# ---------- 飞书（企业自建应用） ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 飞书地址
FEISHU_BASE_URL=https://open.feishu.cn
# 客服群 chat_id；可空（无群会自动建「WhatsApp 客服」）
FEISHU_CHAT_ID=
# 买家来信时额外提醒的群（逗号分隔）
FEISHU_NOTIFY_CHAT_IDS=
FEISHU_NOTIFY_CHAT_NAMES=
# 建客服群时拉入的人 / 其它机器人
FEISHU_INVITE_OPEN_IDS=
FEISHU_INVITE_EMAILS=
FEISHU_INVITE_MOBILES=
FEISHU_INVITE_APP_IDS=
